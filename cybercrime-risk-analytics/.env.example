# ============================================================================
# CYBERCRIME PREDICTIVE ANALYTICS FRAMEWORK (Problem Statement ID: 26184)
# SAFE ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and configure environment-specific values.
# NEVER commit the active .env file containing real secrets to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000

# ----------------------------------------------------------------------------
# 2. POSTGRESQL / POSTGIS DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Connection string format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# In CSV_FALLBACK_DEV mode (default when DB is unreachable), this can remain empty.
DATABASE_URL=postgresql+psycopg://postgres:replace_with_secure_db_password@localhost:5432/cybercrime_prediction

# Database connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Automatically persist prediction results to database when connected
ENABLE_PREDICTION_STORAGE=true

# Force database requirement (if true, application fails startup if DB offline)
FORCE_DATABASE=false

# ----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY CONFIGURATION
# ----------------------------------------------------------------------------
# Cryptographic secret used to sign HS256 JWT tokens.
# Must be replaced with a high-entropy 64+ character key in production.
ANALYST_JWT_SECRET=replace_with_secure_64char_jwt_secret_key_for_production_deployment

# JWT access token lifetime in minutes (480 = 8 hours / standard operational shift)
ANALYST_TOKEN_EXPIRE_MINUTES=480

# Static API key header guard (X-API-Key) used by internal dashboard JS
DASHBOARD_API_KEY=replace_with_custom_secure_dashboard_api_key

# Test/Development bypass flag (MUST be false in staging and production)
DISABLE_API_KEY_AUTH=false

# ----------------------------------------------------------------------------
# 4. PROTOTYPE DEMONSTRATION USER CREDENTIALS (DEVELOPMENT/DEMO ONLY)
# ----------------------------------------------------------------------------
# Placeholders for development demo accounts. Do NOT use default passwords in production.
DEMO_ANALYST_USER=demo_analyst
DEMO_ANALYST_PASS=replace_with_secure_analyst_password

DEMO_SUPERVISOR_USER=demo_supervisor
DEMO_SUPERVISOR_PASS=replace_with_secure_supervisor_password

DEMO_ADMIN_USER=demo_admin
DEMO_ADMIN_PASS=replace_with_secure_admin_password

DEMO_BANK_USER=demo_bank
DEMO_BANK_PASS=replace_with_secure_bank_password

# ----------------------------------------------------------------------------
# 5. ALERT NOTIFICATIONS & SIMULATION TELEMETRY
# ----------------------------------------------------------------------------
# Notifications operate in simulation/log mode by default.
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@cybercrime-analytics.local
SMTP_PASSWORD=replace_with_smtp_password
ALERT_EMAIL_FROM=alerts@cybercrime-analytics.local
ALERT_EMAIL_TO=analyst-oncall@cybercrime-analytics.local

# Webhook dispatch simulation
ENABLE_WEBHOOK_ALERTS=false
ALERT_WEBHOOK_URL=https://api.example.com/webhooks/alerts
